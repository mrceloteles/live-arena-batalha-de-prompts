# Copie para .env e preencha. O .env nunca deve ir para o git (ja ignorado).
NODE_ENV=development
PORT=3000
# Caminho do SQLite em disco (arquivo local). Em hosts em nuvem sem disco
# persistente, este arquivo precisa de volume persistente ou de um SQLite
# hospedado (Turso/libSQL).
DATABASE_PATH=./var/descubra-o-prompt.sqlite

# Perfil de hospedagem recomendado: UM processo com volume persistente e o
# arquivo SQLite local. O estado de tempo real, os limitadores e a fila de
# escrita vivem na memoria de uma instancia; duas instancias nao se enxergam.
#
# Producao (Turso): quando TURSO_URL estiver definido, o banco passa a ser o
# SQLite hospedado do Turso (libsql://<db>.<org>.turso.io) e DATABASE_PATH e
# ignorado. ATENCAO: a integridade referencial do caminho remoto nao esta
# comprovada, e em producao o boot RECUSA este backend ate que a prova seja
# registrada aqui embaixo. A prova e feita no banco de verdade:
#
#   npm run validar-integridade        (cria referencia orfa e ve se o banco recusa)
#   TURSO_INTEGRITY_VERIFIED=1         (so depois de o comando acima passar)
TURSO_URL=
TURSO_AUTH_TOKEN=
TURSO_INTEGRITY_VERIFIED=

# Proxies confiaveis (um por vez, separados por virgula): so quem estiver nesta
# lista pode informar o IP do visitante por X-Forwarded-For. Sem isso, o
# limitador de tentativas conta o proxy como se fosse todos os alunos juntos —
# alguns PINs errados travam a turma inteira. Aceita endereco IP ou faixa IPv4
# (ex.: 172.17.0.0/16); nome de host nao e resolvido.
TRUSTED_PROXIES=127.0.0.1,::1

# Prazo do encerramento gracioso, em milissegundos. O SIGTERM tira a instancia
# do rodizio, cancela chamadas externas em voo, revoga os streams e espera as
# operacoes terminarem; deve ficar abaixo do timeout do host (padrao 9000).
SHUTDOWN_TIMEOUT_MS=9000

# Politica de provedor dos DOIS juizes (classico e por criterios da Arena):
# fallback = os dois locais e deterministicos; nunca acessa a rede, mesmo com
#            GEMINI_API_KEY preenchida (ideal para ensaio em sala)
# gemini = os dois chamam Gemini (classico: saida numerica do pacote-base;
#          criterios: JSON estruturado) e, em falha do provedor, estacionam a
#          avaliacao para reprocessar (nao gravam nota local)
# gemini-safe = os dois exigem resposta estruturada valida; sem chave o boot falha
# Modo desconhecido falha no boot com a lista de modos aceitos.
#
# O QUE ACONTECE QUANDO O PROVEDOR FALHA (desde 17/09/2026, nos dois modos com
# provedor): a avaliacao nao vira nota local. Ela e ESTACIONADA e reprocessada
# sozinha com espera crescente (src/judge/parking.mjs), e a submissao do aluno
# fica visivel como envio sem avaliacao ate a nota chegar do provedor. Medido
# antes disto: com o projeto negado (403), `gemini` gravava nota LOCAL em 6 de 6
# submissoes, com cara de avaliada, e o aluno nao tinha como perceber.
#
# A heuristica local NAO sumiu: ela responde por CONFIGURACAO (sem
# GEMINI_API_KEY, nos dois modos com provedor) e por REGRA (texto ilegivel), que
# sao casos em que nao existe avaliacao a pedir ao provedor.
#
# Cota (429) e defeito do provedor (5xx) se repetem com espera ANTES de
# estacionar (src/judge/retry.mjs); 403 nao se repete: e definitivo.
# Teto de reprocessamentos: 4 tentativas (5s, 10s, 20s, 40s, com teto de 60s),
# respeitando Retry-After. Depois disso a submissao fica SEM nota, o fato entra
# em `judge_parking.exhausted` no /readyz (com aviso) e o aluno pode reenviar a
# mesma tentativa. Nunca ha nota heuristica por falha do provedor.
# Para producao com provedor externo, use gemini-safe.
JUDGE_MODE=fallback
GEMINI_API_KEY=
# Deixe vazio para usar o modelo padrao do modo escolhido.
GEMINI_MODEL=
# Endpoint do provedor. Deixe VAZIO em producao (usa o oficial).
# Serve para HOMOLOGACAO e MEDICAO: apontando para um provedor controlado na
# propria maquina, a carga roda pelo adaptador de verdade (fetch, timeout,
# repeticao, parsing) sem gastar cota e sem mandar prompt de aluno para fora.
#   npm run carga:http -- --alunos 35 --missoes 3 --latencia 120
# URL torta FALHA no boot; endpoint alternativo aparece como aviso no /readyz.
# Nunca aponte para um destino que voce nao controla.
GEMINI_BASE_URL=

# Teto de avaliacoes EXTERNAS desta instalacao (ignorado em JUDGE_MODE=fallback,
# que nao usa rede). Os padroes servem uma turma de 50 sem chegar perto da fila;
# eles existem para o caso em que o provedor trava.
#   JUDGE_CONCURRENCY   avaliacoes simultaneas (padrao 4)
#   JUDGE_CALLS_PER_HOUR chamadas por hora (padrao 400)
#   JUDGE_QUEUE_MAX     quantas podem esperar na fila (padrao 64)
# Estourar o teto NAO gera nota local: o aluno recebe uma recusa recuperavel
# (503 + Retry-After), a avaliacao entra no mesmo patio de reprocessamento e
# repetir continua a MESMA avaliacao. Ou seja: a nota chega mesmo que o aluno
# nao clique de novo.
JUDGE_CONCURRENCY=
JUDGE_CALLS_PER_HOUR=
JUDGE_QUEUE_MAX=

# Quanto o envio do aluno espera a avaliacao antes de responder "pendente" (ms).
# A avaliacao CONTINUA e a nota chega pela consulta de estado; o cliente espera
# mais que isto, para nao anunciar falha de rede enquanto o servidor avalia.
SUBMIT_WAIT_MS=8000

# A FILA de avaliacoes que ficaram sem nota. A fila e o BANCO (submissao sem
# linha em arena_scores), nao a memoria: por isso um redeploy nao custa a nota de
# quem ja enviou. O VIGIA abaixo e o relogio de espera de quem esta de pe:
#   JUDGE_PARK_SWEEP_MS   de quanto em quanto olhar a fila (padrao 60000; 0 desliga)
#   JUDGE_PARK_REARM_MS   espera antes de rearmar o que ja esgotou as tentativas
#                         seguidas (padrao 600000)
#   JUDGE_PARK_REARMS     quantas vezes rearmar cada submissao (padrao 6)
# Com os padroes, uma submissao que fica sem nota recebe no maximo 1 (envio) + 4
# (tentativas seguidas) + 6 (rearmes, um por vez, espacados) tentativas. Existe
# um teto porque um provedor fora por horas nao pode virar laco: o teto de custo
# da hora (JUDGE_CALLS_PER_HOUR) continua valendo por cima disto.
JUDGE_PARK_SWEEP_MS=
JUDGE_PARK_REARM_MS=
JUDGE_PARK_REARMS=

# Acesso admin. Em NODE_ENV=production o boot FALHA sem estes dois: painel
# desabilitado nao e modo degradado, e implantacao que nao funciona.
# Gere segredos fortes, ex.: openssl rand -base64 24
ADMIN_PASSWORD=
ADMIN_SECRET=

# Nomes preservados do pacote de origem (contrato documental). Nao sao lidos
# pelo codigo atual; mantenha vazios.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
